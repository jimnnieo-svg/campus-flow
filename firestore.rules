rules_version = '2';

// 개선안: Firebase Console에 직접 게시하기 전에는 서버에 적용되지 않습니다.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validTodo(data) {
      return data.keys().hasAll([
          'title', 'subject', 'dueDate', 'priority', 'memo',
          'completed', 'createdAt', 'updatedAt', 'completedAt'
        ])
        && data.keys().hasOnly([
          'title', 'subject', 'dueDate', 'priority', 'memo',
          'completed', 'createdAt', 'updatedAt', 'completedAt'
        ])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.title.matches('.*[^\\s].*')
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 40
        && data.subject.matches('.*[^\\s].*')
        && data.memo is string && data.memo.size() <= 2000
        && data.dueDate is string
        && data.dueDate >= '1900-01-01'
        && data.dueDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && data.priority in ['high', 'normal', 'low']
        && data.completed is bool
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt == request.time
        && data.updatedAt >= data.createdAt
        && ((data.completed == false && data.completedAt == null)
          || (data.completed == true && data.completedAt is timestamp
            && data.completedAt >= data.createdAt && data.completedAt <= data.updatedAt));
    }

    match /users/{userId}/todos/{todoId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && validTodo(request.resource.data);
      allow update: if isOwner(userId)
        && validTodo(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
